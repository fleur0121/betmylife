GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
NLP_MODEL=gemini-3.8-flash
# Maximum real analysis calls per backend process (failed calls count too).
NLP_MAX_CALLS=50

# Optional unified ML prediction service. If unreachable, challenge creation
# succeeds with the explicit 50% / 2.0 / 2.0 fallback and a backend warning.
ML_API_URL=http://127.0.0.1:8001/predict

# TiDB Cloud connection
TIDB_HOST=gateway01.us-west-2.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your_tidb_user
TIDB_PASSWORD=your_tidb_password
TIDB_DATABASE=predict_my_life
# Download the TiDB Cloud CA certificate and set its local path.
TIDB_CA_PATH=/absolute/path/to/ca.pem
