# Copy this file to .env before running Docker Compose.
# The defaults are only for local development.
MYSQL_DATABASE=predict_my_life
MYSQL_USER=betmylife
MYSQL_PASSWORD=betmylife_dev
MYSQL_ROOT_PASSWORD=root_dev_only

API_PORT=8000
EXPO_PORT=8081
EXPO_PUBLIC_API_URL=http://localhost:8000
REACT_NATIVE_PACKAGER_HOSTNAME=localhost
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Optional. Translation and AI proof planning return 503 when this is empty.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
